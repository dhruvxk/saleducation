---
const path = Astro.url.pathname;
---
<div class="utility-bar">
  <div class="container utility-inner">
    <span class="utility-location"><span class="live-dot" aria-hidden="true"></span> SAL Education Campus <span class="utility-divider">·</span> Ahmedabad, Gujarat</span>
    <div class="utility-links"><a href="/events/">Campus calendar <span aria-hidden="true">↗</span></a><a href="/student-grievance/">Student grievance <span aria-hidden="true">↗</span></a><a href="tel:+917967129000">+91 79 6712 9000</a></div>
  </div>
</div>
<header class="site-header" id="top">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="SAL Education home"><img src="/assets/sal-mark.svg" alt="" width="48" height="48"><span class="brand-copy"><strong>SAL</strong><span>EDUCATION</span></span></a>
    <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Open navigation"><span></span><span></span></button>
    <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
      <details class="nav-menu">
        <summary>About <span class="chevron" aria-hidden="true"></span></summary>
        <div class="mega-menu mega-about">
          <div class="mega-intro"><span class="eyebrow">About SAL</span><h3>Connected learning, grounded in purpose.</h3><a class="text-link" href="/about/">Discover SAL <span aria-hidden="true">↗</span></a></div>
          <div class="mega-column"><span class="mega-label">Leadership &amp; direction</span><a href="/about/">About SAL Education</a><a href="https://sal.edu.in/vision-mission-objectives" target="_blank" rel="noopener">Vision, mission &amp; objectives</a><a href="https://sal.edu.in/chairman-message" target="_blank" rel="noopener">Chairman’s message</a><a href="https://sal.edu.in/vice-chairman-message" target="_blank" rel="noopener">Vice Chairman’s message</a><a href="https://sal.edu.in/general-manager-message" target="_blank" rel="noopener">General Manager’s message</a><a href="https://sal.edu.in/director-message" target="_blank" rel="noopener">Director’s message</a><a href="https://sal.edu.in/associate-director-message" target="_blank" rel="noopener">Associate Director’s message</a></div>
          <div class="mega-column"><span class="mega-label">Governance &amp; recognition</span><a href="https://sal.edu.in/award-and-recognition" target="_blank" rel="noopener">Awards &amp; recognition</a><a href="https://sal.edu.in/appreciation" target="_blank" rel="noopener">Appreciation</a><a href="https://sal.edu.in/governing-body" target="_blank" rel="noopener">Governing body</a><a href="https://sal.edu.in/committee" target="_blank" rel="noopener">Committees</a><a href="/resources/">Boards, councils &amp; disclosures</a></div>
        </div>
      </details>
      <details class="nav-menu">
        <summary>Academics <span class="chevron" aria-hidden="true"></span></summary>
        <div class="mega-menu mega-academics">
          <div class="mega-intro"><span class="eyebrow">Find your direction</span><h3>Learning for what comes next.</h3><a class="text-link" href="/programs/">Explore all programs <span aria-hidden="true">↗</span></a></div>
          <div class="mega-column"><span class="mega-label">Study level</span><a href="/programs/?level=diploma">Diploma programs</a><a href="/programs/?level=bachelor">Bachelor degrees</a><a href="/programs/?level=master">Master degrees</a><a href="/programs/?level=doctoral">Doctoral programs</a><a href="https://sal.edu.in/courses" target="_blank" rel="noopener">Official course catalog <span aria-hidden="true">↗</span></a></div>
          <div class="mega-column"><span class="mega-label">Schools &amp; institutes</span><a href="/institutes/">Browse all institutes</a><a href="/institutes/sal-institute-of-technology-engineering-research/">Engineering &amp; technology</a><a href="/institutes/sal-institute-of-management/">Management</a><a href="/institutes/sal-institute-of-pharmacy/">Pharmacy</a><a href="/institutes/sal-school-of-architecture/">Architecture &amp; design</a><a href="/institutes/sal-institute-of-medical-sciences/">Medical sciences</a></div>
        </div>
      </details>
      <details class="nav-menu">
        <summary>Campus life <span class="chevron" aria-hidden="true"></span></summary>
        <div class="mega-menu mega-life">
          <div class="mega-intro"><span class="eyebrow">Life at SAL</span><h3>A campus built for more than class.</h3><a class="text-link" href="/campus-life/">Explore campus life <span aria-hidden="true">↗</span></a></div>
          <div class="mega-column"><span class="mega-label">Facilities</span><a href="https://sal.edu.in/auditorium-seminar-room" target="_blank" rel="noopener">Auditorium &amp; seminar rooms</a><a href="https://sal.edu.in/library" target="_blank" rel="noopener">Library</a><a href="https://sal.edu.in/cafeteria" target="_blank" rel="noopener">Cafeteria</a><a href="https://sal.edu.in/healthcare" target="_blank" rel="noopener">Healthcare</a><a href="https://sal.edu.in/sports-facilities" target="_blank" rel="noopener">Sports</a><a href="https://sal.edu.in/parking" target="_blank" rel="noopener">Parking</a></div>
          <div class="mega-column"><span class="mega-label">Activities &amp; media</span><a href="/events/">All events</a><a href="https://sal.edu.in/ssip" target="_blank" rel="noopener">SSIP</a><a href="https://sal.edu.in/iic" target="_blank" rel="noopener">Institutions Innovation Council</a><a href="https://sal.edu.in/iste" target="_blank" rel="noopener">ISTE</a><a href="https://sal.edu.in/technical-festival" target="_blank" rel="noopener">Technical festival</a><a href="https://sal.edu.in/cultural-festival" target="_blank" rel="noopener">Cultural festival</a><a href="/news/">News &amp; articles</a></div>
        </div>
      </details>
      <a class="nav-link" href="/placements/" aria-current={path.startsWith("/placements/") ? "page" : undefined}>Placements</a>
      <a class="nav-link" href="/international/" aria-current={path.startsWith("/international/") ? "page" : undefined}>International</a>
    </nav>
    <a class="button button-dark header-cta" href="/contact/">Talk to admissions <span aria-hidden="true">↗</span></a>
  </div>
</header>
