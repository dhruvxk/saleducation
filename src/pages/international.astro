---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ResourceGrid from "../components/ResourceGrid.astro";
---
<BaseLayout title="International" description="International student pathways and collaboration resources at SAL Education, Ahmedabad.">
  <PageIntro number="07" label="INTERNATIONAL" eyebrow="A campus with a global outlook" title="Bring your world<br><em>to SAL.</em>" lead="SAL International provides information for incoming and outgoing students and international collaborations. Check each official resource for current eligibility, programs and processes." />
  <section class="section international-section"><div class="container international-grid"><div class="international-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="orbit-core"><span>SAL</span><small>GLOBAL</small></div><span class="orbit-label orbit-label-one">AHMEDABAD</span><span class="orbit-label orbit-label-two">CONNECT</span><span class="orbit-label orbit-label-three">LEARN</span><span class="orbit-star">✳</span></div><div class="international-copy"><div class="section-label"><span>01</span><span class="label-rule"></span><span>INTERNATIONAL STUDENT SUPPORT</span></div><span class="eyebrow">Study in India</span><h2>Start with the<br><em>right guidance.</em></h2><p>SAL’s incoming student page describes government-sponsored and self-financed pathways, with support around admissions, visa processing, housing and campus integration.</p><a class="button button-dark" href="https://sal.edu.in/incoming-students-study-in-india" target="_blank" rel="noopener">Incoming student information <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section resource-section"><div class="container"><div class="section-head"><div><div class="section-label"><span>02</span><span class="label-rule"></span><span>INTERNATIONAL RESOURCES</span></div><span class="eyebrow">Explore pathways</span><h2>Connect beyond<br><em>the campus.</em></h2></div><div class="section-head-aside"><p>Open official SAL pages for incoming students, study abroad and institutional collaborations.</p></div></div><ResourceGrid section="International" /></div></section>
</BaseLayout>
