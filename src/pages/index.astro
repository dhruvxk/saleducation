---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramGrid from "../components/ProgramGrid.astro";
import InstituteGrid from "../components/InstituteGrid.astro";
import NoticeList from "../components/NoticeList.astro";
import NewsGrid from "../components/NewsGrid.astro";
---
<BaseLayout title="Home" description="Explore SAL Education programs, institutes, campus life and admissions in Ahmedabad.">
  <section class="hero" aria-labelledby="hero-title"><img class="hero-image" src="https://sal.edu.in/storage/banners/cover-images-1.webp" alt="SAL Education campus" fetchpriority="high"><div class="hero-scrim"></div><div class="container hero-content"><div class="hero-copy"><span class="hero-kicker"><span class="kicker-line"></span> One campus. Many ways forward.</span><h1 id="hero-title">Make your<br>next move <em>matter.</em></h1><p>Find the course, community and confidence to shape a future that feels like yours. Explore a connected campus for engineering, business, health, design and more.</p><div class="hero-actions"><a class="button button-accent" href="/programs/">Explore programs <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="/about/"><span class="play-mark" aria-hidden="true">↗</span> Discover SAL</a><a class="hero-secondary brochure-link" href="https://sal.edu.in/storage/sal-education-2026-final-c.pdf" target="_blank" rel="noopener">Download brochure <span aria-hidden="true">↗</span></a></div><div class="hero-proof"><span class="proof-stars" aria-hidden="true">✳</span><span><strong>Learn across disciplines</strong><br>Engineering · Management · Health · Design</span></div></div><aside class="hero-notice"><div class="notice-topline"><span class="notice-pulse"></span> ADMISSIONS · 2026–27</div><h2>Start with the<br>right information.</h2><p>Read the admission circulars from SAL institutes and confirm dates with the relevant office.</p><a href="/admissions/" class="notice-link">View admission notices <span aria-hidden="true">↗</span></a><div class="notice-index"><span>01</span><span class="notice-index-line"></span><span>OFFICIAL UPDATES</span></div></aside></div><a class="hero-scroll" href="#about"><span class="scroll-line"></span> Scroll to explore</a></section>
  <section class="marquee-band" aria-label="SAL areas of study"><div class="marquee-track"><span>Engineering</span><i>✳</i><span>Management</span><i>✳</i><span>Pharmacy</span><i>✳</i><span>Architecture</span><i>✳</i><span>Medical sciences</span><i>✳</i><span>Computer applications</span><i>✳</i><span>Engineering</span><i>✳</i><span>Management</span><i>✳</i><span>Pharmacy</span><i>✳</i><span>Architecture</span><i>✳</i><span>Medical sciences</span><i>✳</i><span>Computer applications</span><i>✳</i></div></section>
  <section class="section about-section" id="about"><div class="container about-grid"><div class="section-label"><span>01</span><span class="label-rule"></span><span>THE SAL EXPERIENCE</span></div><div class="about-title"><span class="eyebrow">Ideas grow here</span><h2>Learn with purpose.<br><em>Lead with possibility.</em></h2></div><div class="about-copy"><p>SAL Education brings specialist academic institutes together on one Ahmedabad campus. Students can build practical knowledge, explore new interests and prepare for meaningful work in a changing world.</p><a class="text-link" href="/about/">Get to know SAL <span aria-hidden="true">↗</span></a></div><div class="about-visual"><img src="https://sal.edu.in/storage/banners/cover-images-2.webp" alt="SAL Education campus spaces" loading="lazy"><div class="image-caption"><span class="caption-dot"></span> SAL Education Campus <span>Ahmedabad, Gujarat</span></div><div class="visual-stamp" aria-hidden="true"><span>LEARN</span><b>×</b><span>CREATE</span><b>×</b><span>GROW</span></div></div><div class="about-callout"><span class="callout-spark" aria-hidden="true">✳</span><p>“Empowering minds,<br>shaping futures.”</p><span class="callout-source">SAL Education</span></div><div class="about-link-row"><a href="/resources/">Governance &amp; disclosures <span>↗</span></a><a href="/institutes/">Our institutes <span>↗</span></a><a href="https://sal.edu.in/award-and-recognition" target="_blank" rel="noopener">Awards &amp; recognition <span>↗</span></a><a href="/contact/">Contact SAL <span>↗</span></a></div></div></section>
  <section class="section programs-section"><div class="container"><div class="section-head"><div><div class="section-label"><span>02</span><span class="label-rule"></span><span>FIND YOUR PROGRAM</span></div><span class="eyebrow">A course for your next chapter</span><h2>Choose a path.<br><em>Keep your options open.</em></h2></div><div class="section-head-aside"><p>Browse programs from diploma to doctoral study across SAL’s institutes.</p><a class="text-link" href="/programs/">See the full catalog <span aria-hidden="true">↗</span></a></div></div><div class="course-finder"><ProgramGrid limit={6} /><div class="catalog-footer"><span>See the official catalog for the latest availability and intake details.</span><a class="button button-outline" href="/programs/">Browse all programs <span aria-hidden="true">↗</span></a></div></div></div></section>
  <section class="section institutes-section"><div class="container"><div class="section-head compact-head"><div><div class="section-label"><span>03</span><span class="label-rule"></span><span>OUR INSTITUTES</span></div><span class="eyebrow">One campus, distinct communities</span><h2>Find your <em>school.</em></h2></div><p class="section-head-aside">Specialist learning communities across technical, professional, creative and health disciplines.</p></div><InstituteGrid limit={6} /><div class="institute-footnote"><span>Explore all institute websites and programs.</span><a href="/institutes/">Browse all institutes <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section notice-section"><div class="container notice-layout"><div class="notice-intro"><div class="section-label light-label"><span>04</span><span class="label-rule"></span><span>ADMISSION DESK</span></div><span class="eyebrow">Official circulars · 2026–27</span><h2>Make your next step<br><em>an informed one.</em></h2><p>Some published application and counselling dates have passed. Open each circular and contact the relevant institute to confirm current availability.</p><a class="button button-light" href="/admissions/">See all notices <span aria-hidden="true">↗</span></a></div><NoticeList limit={5} /></div></section>
  <section class="section life-section"><div class="container"><div class="section-head"><div><div class="section-label"><span>05</span><span class="label-rule"></span><span>BEYOND THE CLASSROOM</span></div><span class="eyebrow">Life at SAL</span><h2>Room to learn.<br><em>Space to belong.</em></h2></div><div class="section-head-aside"><p>Discover the campus facilities, student activities and shared experiences available across SAL.</p><a class="text-link" href="/campus-life/">Explore campus life <span aria-hidden="true">↗</span></a></div></div><div class="life-mosaic"><a class="life-photo life-photo-main" href="/campus-life/"><img src="https://sal.edu.in/storage/banners/cover-image-a.webp" alt="SAL Education campus" loading="lazy"><span class="photo-overlay"></span><span class="photo-topline">CAMPUS SPACES · 01</span><span class="photo-caption">A place to<br>find your people.</span><span class="photo-arrow">↗</span></a><a class="life-tile tile-library" href="https://sal.edu.in/library" target="_blank" rel="noopener"><span class="tile-number">01</span><span class="tile-symbol">▤</span><h3>Library</h3><span class="tile-link">Explore the space ↗</span></a><a class="life-tile tile-auditorium" href="https://sal.edu.in/auditorium-seminar-room" target="_blank" rel="noopener"><span class="tile-number">02</span><span class="tile-symbol">◉</span><h3>Auditorium &amp;<br>seminar rooms</h3><span class="tile-link">Explore the space ↗</span></a><a class="life-tile tile-activities" href="/events/"><span class="tile-number">03</span><span class="tile-symbol">✳</span><h3>Events &amp;<br>student activities</h3><span class="tile-link">See campus calendar ↗</span></a><a class="life-photo life-photo-small" href="/campus-life/"><img src="https://sal.edu.in/storage/banners/cover-image-b.webp" alt="SAL Education campus activity" loading="lazy"><span class="photo-overlay"></span><span class="photo-topline">CAMPUS COMMUNITY · 02</span><span class="photo-caption">Make space<br>for new ideas.</span><span class="photo-arrow">↗</span></a></div></div></section>
  <section class="section careers-section"><div class="container careers-grid"><div class="careers-copy"><div class="section-label light-label"><span>06</span><span class="label-rule"></span><span>CAREERS &amp; CONNECTIONS</span></div><span class="eyebrow">From learning to doing</span><h2>Prepare for work<br><em>that matters.</em></h2><p>SAL’s Training &amp; Placement Cell supports career planning, skill development and connections with recruiters.</p><a class="button button-light" href="/placements/">Explore placements <span aria-hidden="true">↗</span></a></div><div class="career-links"><a href="https://sal.edu.in/for-students" target="_blank" rel="noopener"><span>01</span><strong>For students</strong><b>↗</b><small>Career guidance and student support</small></a><a href="https://sal.edu.in/for-recruiters" target="_blank" rel="noopener"><span>02</span><strong>For recruiters</strong><b>↗</b><small>Connect with the placement cell</small></a><a href="https://sal.edu.in/our-recruiters" target="_blank" rel="noopener"><span>03</span><strong>Recruiter network</strong><b>↗</b><small>Organizations featured by SAL</small></a><a href="https://sal.edu.in/placement-reports" target="_blank" rel="noopener"><span>04</span><strong>Placement reports</strong><b>↗</b><small>Published reports and updates</small></a></div></div></section>
  <section class="section news-section"><div class="container"><div class="section-head news-head"><div><div class="section-label"><span>07</span><span class="label-rule"></span><span>WHAT’S HAPPENING</span></div><span class="eyebrow">Notes from the SAL community</span><h2>Campus life,<br><em>in motion.</em></h2></div><div class="news-actions"><a class="text-link" href="/news/">All news &amp; articles <span aria-hidden="true">↗</span></a><a class="text-link" href="/events/">All events <span aria-hidden="true">↗</span></a></div></div><NewsGrid limit={3} /></div></section>
  <section class="section international-section"><div class="container international-grid"><div class="international-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="orbit-core"><span>SAL</span><small>GLOBAL</small></div><span class="orbit-label orbit-label-one">AHMEDABAD</span><span class="orbit-label orbit-label-two">CONNECT</span><span class="orbit-label orbit-label-three">LEARN</span><span class="orbit-star">✳</span></div><div class="international-copy"><div class="section-label"><span>08</span><span class="label-rule"></span><span>INTERNATIONAL</span></div><span class="eyebrow">A campus with a global outlook</span><h2>Bring your world<br><em>to SAL.</em></h2><p>SAL International supports incoming students with program information, eligibility, visa guidance and arrival support.</p><a class="button button-dark" href="/international/">Explore international pathways <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="home-contact-band"><div class="container home-contact-inner"><div><span class="eyebrow">Your next step</span><h2>Let’s find your <em>way forward.</em></h2></div><a class="button button-accent" href="/contact/">Talk to admissions <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
