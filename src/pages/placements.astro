---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ResourceGrid from "../components/ResourceGrid.astro";
---
<BaseLayout title="Placements & Careers" description="SAL Education Training and Placement Cell resources for students and recruiters.">
  <PageIntro number="06" label="PLACEMENTS & CAREERS" eyebrow="From learning to doing" title="Prepare for work<br><em>that matters.</em>" lead="SAL Education’s Training & Placement Cell describes its work as connecting student talent with opportunity through career support, skill development and recruiter relationships." />
  <section class="section careers-section"><div class="container careers-grid"><div class="careers-copy"><div class="section-label light-label"><span>01</span><span class="label-rule"></span><span>TRAINING &amp; PLACEMENT CELL</span></div><span class="eyebrow">Career pathways</span><h2>Build skills.<br><em>Meet opportunity.</em></h2><p>The placement cell outlines career planning, training, corporate interactions, placement activities and recruiter connections for students and partners.</p><a class="button button-light" href="https://sal.edu.in/overview" target="_blank" rel="noopener">Official placement overview <span aria-hidden="true">↗</span></a></div><div class="placement-principles"><div><span>VISION</span><p>Connect talent with opportunity, foster continuous learning and help students grow into industry-ready professionals and global leaders.</p></div><div><span>MISSION</span><p>Bridge academia and industry, support career planning and develop the professional skills students need for a changing job market.</p></div></div></div></section>
  <section class="section resource-section"><div class="container"><div class="section-head"><div><div class="section-label"><span>02</span><span class="label-rule"></span><span>CAREER RESOURCES</span></div><span class="eyebrow">Students, recruiters and partners</span><h2>Open the right <em>door.</em></h2></div><div class="section-head-aside"><p>Use the official pages for published reports, placement activities and cell contacts.</p></div></div><ResourceGrid section="Placement" /></div></section>
</BaseLayout>
