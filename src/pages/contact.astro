---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
---
<BaseLayout title="Contact SAL Education" description="Contact SAL Education for general and admissions inquiries. Find the Ahmedabad campus address, phone, email and map.">
  <PageIntro number="10" label="CONTACT" eyebrow="We’re here to help" title="Let’s find your<br><em>way forward.</em>" lead="Reach the SAL Education campus for general and admissions inquiries. Confirm program availability with the institute before applying." />
  <section class="section contact-section"><div class="container contact-grid"><div class="contact-card"><span class="contact-icon">⌖</span><span class="contact-label">CAMPUS ADDRESS</span><h2>Visit SAL Education.</h2><address>SAL Education Campus<br>Opp. Science City, Sola Bhadaj Road<br>Ahmedabad – 380060<br>Gujarat, India</address><a class="text-link" href="https://maps.google.com/?q=SAL+Education+Campus+Ahmedabad" target="_blank" rel="noopener">Open campus map <span aria-hidden="true">↗</span></a></div><div class="contact-card"><span class="contact-icon">✆</span><span class="contact-label">PHONE</span><h2>Speak with our team.</h2><a href="tel:+917967129000">+91 79 6712 9000</a><a href="tel:+917967129001">079 6712 9001 to 16 · campus switchboard</a><a href="tel:+919925195966">+91 99251 95966 / 5536 · admissions</a></div><div class="contact-card"><span class="contact-icon">✉</span><span class="contact-label">EMAIL</span><h2>Write to SAL.</h2><a href="mailto:info@sal.edu.in">info@sal.edu.in</a><a href="mailto:admission@sal.edu.in">admission@sal.edu.in</a><a href="https://sal.edu.in/contact" target="_blank" rel="noopener">Official contact page ↗</a></div><div class="contact-social"><span class="eyebrow">Follow SAL Education</span><h2>Keep in <em>touch.</em></h2><a href="https://www.facebook.com/saleducationsal/" target="_blank" rel="noopener">Facebook <span>↗</span></a><a href="https://www.instagram.com/saleducation" target="_blank" rel="noopener">Instagram <span>↗</span></a></div></div></section>
  <section class="section enquiry-section"><div class="container enquiry-grid"><div class="enquiry-copy"><div class="section-label light-label"><span>01</span><span class="label-rule"></span><span>ADMISSION INQUIRY</span></div><span class="eyebrow">Ask about your next step</span><h2>Tell us what<br><em>you’re looking for.</em></h2><p>The inquiry form prepares an email addressed to admissions. Review it in your email app before sending.</p><div class="admissions-contact"><span>Admissions desk</span><a href="mailto:admission@sal.edu.in">admission@sal.edu.in</a><a href="tel:+917967129000">+91 79 6712 9000</a></div></div><form class="enquiry-form" data-mailto-form><div class="form-heading"><span>ADMISSION INQUIRY</span><span class="form-required">* REQUIRED</span></div><div class="form-grid"><label>Name <span>*</span><input name="name" autocomplete="name" required placeholder="Your full name"></label><label>Email <span>*</span><input name="email" type="email" autocomplete="email" required placeholder="you@example.com"></label><label>Mobile number <span>*</span><input name="mobile" type="tel" autocomplete="tel" required placeholder="+91"></label><label>City <span>*</span><input name="city" autocomplete="address-level2" required placeholder="Your city"></label><label class="field-wide">Program of interest <span>*</span><select name="program" required><option value="" disabled selected>Select a program area</option><option>Engineering &amp; technology</option><option>Computer applications</option><option>Management</option><option>Pharmacy</option><option>Architecture</option><option>Interior design</option><option>Medical sciences</option><option>Not sure yet</option></select></label><label class="field-wide">Subject<input name="subject" placeholder="Optional subject"></label><label class="field-wide">Message<textarea name="message" rows="3" placeholder="What would you like to know?"></textarea></label></div><button class="button button-accent form-submit" type="submit">Prepare email inquiry <span aria-hidden="true">↗</span></button><p class="form-note" data-form-note aria-live="polite">No information is sent to a server by this static form.</p></form></div></section>
</BaseLayout>
